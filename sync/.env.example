# Copy to .env NEXT TO sync_worker.py on the Windows VM and fill in.
# NEVER commit the real .env.

# Sage X3 SQL Server (over the Fortinet VPN).
# Production: use a dedicated READ-ONLY login, not the CASCO account.
SAGE_CONN=DRIVER={ODBC Driver 17 for SQL Server};SERVER=192.168.97.2;DATABASE=x3v12;UID=CASCO;PWD=CHANGE_ME
SAGE_SCHEMA=CASCOQLD

# Only Replacement-Parts POs (custom PO checkbox; X3: 2=Yes).
SAGE_RP_FILTER=h.ZRPP_0 = 2

# Cloud Postgres over the WireGuard tunnel (10.77.0.1 = Hetzner side).
PG_CONN=host=10.77.0.1 dbname=rpp user=rpp_sync password=CHANGE_ME
