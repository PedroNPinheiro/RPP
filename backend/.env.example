# Copy to .env on the Hetzner box (in the backend/ dir). Never commit the real one.

# App connects to LOCAL Postgres as the least-privilege rpp_app role.
DATABASE_URL=host=localhost dbname=rpp user=rpp_app password=CHANGE_ME

# Public URL (OAuth redirect + logout base).
APP_BASE_URL=https://rpp.cascointernal.com

# ---- Entra ID SSO (Backend-For-Frontend / confidential client) ----
# Leave AUTH_ENABLED=false until the Entra app is registered and values set,
# then flip to true and restart. With it false, a dev user is assumed.
AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Signs the HttpOnly session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME
